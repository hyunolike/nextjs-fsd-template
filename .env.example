# Copy to .env.local and adjust as needed. See src/shared/config/env.ts for
# the full schema — anything added there should be added here too.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Server-only. Used to sign the mock backend's demo tokens
# (src/shared/server/fake-jwt.ts). Replace the whole mock backend before
# shipping to production — this is not a real secret.
MOCK_AUTH_SECRET=dev-only-secret-do-not-use-in-prod
